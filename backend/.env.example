# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------
# Database (SQLite by default - zero setup. For Postgres, set:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
# and change `provider` in prisma/schema.prisma to "postgresql")
# ---------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------
# Auth
# ---------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------
# LLM (Anthropic Claude) - used for pre-visit and post-visit summaries
# Get a key from https://console.anthropic.com/
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------
# Email (Nodemailer SMTP - works with SendGrid, Mailgun, Gmail SMTP,
# Mailtrap for testing, etc). Example values are for SendGrid SMTP relay.
# ---------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM="Clinic Appointments <no-reply@yourclinic.com>"

# ---------------------------------------------------------------
# Google Calendar (OAuth 2.0)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback

# ---------------------------------------------------------------
# Booking
# ---------------------------------------------------------------
SLOT_HOLD_TTL_MINUTES=5
